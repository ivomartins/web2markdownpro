{
  "manifest_version": 3,
  "name": "Web2Markdown Pro",
  "version": "1.1",
  "description": "Convert webpage to Markdown with image bundling.",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "clipboardWrite"],
  "icons": {
	"16": "icons/icon16.png",
	"48": "icons/icon48.png",
	"128": "icons/icon128.png"
},
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  }
}
